# Copy to .env if you use a local shell. In Claude or Codex, use environment
# settings for ordinary variables and the secret store for access tokens.
# Source a local .env only if you know and trust its contents.

# export JOYTI_DB='.local/joyti.sqlite3'

# Naver Cafe: use numeric IDs for the cafe and the board.
# export JOYTI_NAVER_CAFE_ID=''
# export JOYTI_NAVER_MENU_ID=''
# export JOYTI_NAVER_ACCESS_TOKEN=''

# Instagram Login: use the numeric ID and API version from your Meta app.
# export JOYTI_IG_USER_ID=''
# export JOYTI_IG_API_VERSION=''
# export JOYTI_IG_ACCESS_TOKEN=''

# Local n8n draft webhook: use a random value of at least 24 characters.
# export JOYTI_WORKFLOW_TOKEN=''

# Gemini/Veo video drafts and native Google Sheets use separate credentials.
# export JOYTI_GEMINI_API_KEY=''
# export JOYTI_GEMINI_TEXT_MODEL='gemini-flash-latest'
# export JOYTI_VEO_MODEL=''
# export JOYTI_SHEETS_ACCESS_TOKEN=''
